{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "roomId",
    "npcId",
    "startStepId",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "roomId": {
      "const": "prototype_room"
    },
    "npcId": {
      "const": "jonas"
    },
    "startStepId": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "text",
          "objective"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "dialogue",
              "real_world_task",
              "measurement",
              "choice",
              "result"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "hints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next": {
            "type": "string"
          },
          "stationId": {
            "enum": [
              "box"
            ]
          },
          "mode": {
            "const": "simulated"
          },
          "safetyText": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "unit": {
            "const": "cm"
          },
          "expected": {
            "type": "object",
            "required": [
              "value",
              "tolerance"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "retryFeedback": {
            "type": "string"
          },
          "successFeedback": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "feedback",
                "next"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "feedback": {
                  "type": "string",
                  "minLength": 1
                },
                "next": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "outcomeId": {
            "type": "string"
          },
          "careerFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reflection": {
            "type": "string"
          },
          "completedText": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dialogue"
                }
              }
            },
            "then": {
              "required": [
                "next"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "real_world_task"
                }
              }
            },
            "then": {
              "required": [
                "next",
                "stationId",
                "mode",
                "safetyText",
                "observation"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "measurement"
                }
              }
            },
            "then": {
              "required": [
                "next",
                "unit",
                "expected",
                "retryFeedback",
                "successFeedback"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choice"
                }
              }
            },
            "then": {
              "required": [
                "options"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "result"
                }
              }
            },
            "then": {
              "required": [
                "outcomeId",
                "careerFields",
                "reflection",
                "completedText"
              ]
            }
          }
        ]
      }
    }
  }
}
